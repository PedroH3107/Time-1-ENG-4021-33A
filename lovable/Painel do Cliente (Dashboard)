<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Painel do Cliente</title>
    <style>
      :root {
        --bg: #f4f7fb;
        --panel: #ffffff;
        --panel-soft: #f9fbff;
        --primary: #5b6cff;
        --primary-strong: #3d4fe0;
        --primary-soft: rgba(91, 108, 255, 0.12);
        --accent: #13c2a5;
        --warning: #ffb648;
        --danger: #ff6b6b;
        --text: #1f2a37;
        --muted: #6d7b8d;
        --line: #e9edf6;
        --shadow: 0 18px 40px rgba(39, 61, 106, 0.12);
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        font-family: Inter, "Segoe UI", Roboto, sans-serif;
        color: var(--text);
      }

      body {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 28px;
      }

      .app-shell {
        width: min(1400px, 100%);
        background: linear-gradient(180deg, #f6f8ff 0%, #f2f6fb 100%);
        border: 1px solid rgba(115, 130, 180, 0.12);
        border-radius: 28px;
        box-shadow: var(--shadow);
        display: grid;
        grid-template-columns: 250px 1fr;
        overflow: hidden;
      }

      .sidebar {
        background: linear-gradient(180deg, #111827 0%, #1d2940 100%);
        color: #edf3ff;
        padding: 24px 18px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        letter-spacing: 0.02em;
        margin-bottom: 32px;
        padding: 8px 10px;
      }

      .logo {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        background: linear-gradient(135deg, #5b6cff, #7b8cff);
        display: grid;
        place-items: center;
        font-size: 1.1rem;
        font-weight: 800;
        box-shadow: 0 12px 20px rgba(91, 108, 255, 0.45);
      }

      .nav {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        border-radius: 12px;
        padding: 12px 14px;
        color: rgba(237, 243, 255, 0.82);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s ease;
      }

      .nav-item.active {
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.04);
      }

      .nav-icon {
        width: 26px;
        height: 26px;
        border-radius: 8px;
        background: rgba(255,255,255,0.06);
        display: grid;
        place-items: center;
        font-size: 0.9rem;
      }

      .sidebar-footer {
        margin-top: 26px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 18px;
        padding: 16px;
      }

      .sidebar-footer .label {
        color: rgba(237,243,255,0.66);
        font-size: 0.72rem;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .mini-card {
        background: linear-gradient(135deg, rgba(91,108,255,0.22), rgba(19,194,165,0.16));
        border-radius: 16px;
        padding: 14px;
      }

      .mini-card strong {
        display: block;
        font-size: 1.55rem;
        margin-top: 8px;
      }

      .content {
        padding: 28px;
      }

      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
      }

      .title-group h1 {
        margin: 0;
        font-size: clamp(1.8rem, 2vw, 2.4rem);
      }

      .title-group p {
        margin: 6px 0 0;
        color: var(--muted);
      }

      .top-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .search {
        width: 240px;
        background: rgba(255,255,255,0.8);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 11px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--muted);
      }

      .search input {
        border: 0;
        background: transparent;
        width: 100%;
        outline: none;
        font-size: 0.95rem;
      }

      .btn {
        border: 0;
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
        cursor: pointer;
      }

      .btn.primary {
        background: linear-gradient(135deg, var(--primary), var(--primary-strong));
        color: #fff;
        box-shadow: 0 12px 22px rgba(91, 108, 255, 0.25);
      }

      .hero {
        background: linear-gradient(135deg, #f4f6ff 0%, #ebf7ff 100%);
        border: 1px solid rgba(103, 115, 255, 0.08);
        border-radius: 22px;
        padding: 22px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        margin-bottom: 22px;
      }

      .hero-copy {
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .avatar {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        background: linear-gradient(135deg, #5b6cff, #7ad7ff);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 1.4rem;
      }

      .hero h2 {
        margin: 0 0 4px;
        font-size: 1.5rem;
      }

      .hero p {
        margin: 0;
        color: var(--muted);
      }

      .hero-badges {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 999px;
        background: rgba(91,108,255,0.08);
        color: var(--primary-strong);
        font-weight: 600;
        font-size: 0.82rem;
      }

      .chip.success {
        background: rgba(19,194,165,0.12);
        color: #108c7b;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: 18px;
        margin-bottom: 22px;
      }

      .stat-card {
        background: rgba(255,255,255,0.85);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 18px;
      }

      .stat-card .meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--muted);
        font-size: 0.88rem;
        margin-bottom: 18px;
      }

      .stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: 1.1rem;
      }

      .stat-card strong {
        display: block;
        font-size: 2rem;
        margin-bottom: 9px;
      }

      .trend {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 8px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 700;
      }

      .trend.up { background: rgba(19,194,165,0.12); color: #0d8a74; }
      .trend.down { background: rgba(255,107,107,0.12); color: #d75757; }

      .stat-card:nth-child(1) .stat-icon { background: rgba(91,108,255,0.12); color: var(--primary-strong); }
      .stat-card:nth-child(2) .stat-icon { background: rgba(19,194,165,0.12); color: #108c7b; }
      .stat-card:nth-child(3) .stat-icon { background: rgba(255,182,72,0.12); color: #d68400; }
      .stat-card:nth-child(4) .stat-icon { background: rgba(255,107,107,0.12); color: #d75757; }

      .main-grid, .bottom-grid {
        display: grid;
        gap: 22px;
      }

      .main-grid {
        grid-template-columns: 1.8fr 1fr;
        margin-bottom: 22px;
      }

      .bottom-grid {
        grid-template-columns: 1.5fr 1fr;
      }

      .panel {
        background: rgba(255,255,255,0.86);
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 20px 20px 18px;
      }

      .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
      }

      .panel-header h3 {
        margin: 0;
        font-size: 1.08rem;
      }

      .panel-header .link {
        color: var(--primary-strong);
        font-weight: 700;
        font-size: 0.84rem;
      }

      .chart-wrap {
        background: linear-gradient(180deg, #fafbff 0%, #fbfcff 100%);
        border-radius: 18px;
        border: 1px solid var(--line);
        padding: 12px 12px 8px;
      }

      .chart {
        width: 100%;
        height: 245px;
        display: block;
      }

      .legend {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 8px;
        color: var(--muted);
        font-size: 0.8rem;
      }

      .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
      }

      .activity-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .activity-item {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 10px 0;
      }

      .activity-item + .activity-item {
        border-top: 1px solid var(--line);
      }

      .activity-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-weight: 700;
      }

      .activity-item .meta {
        flex: 1;
      }

      .activity-item h4 {
        margin: 0 0 3px;
        font-size: 0.96rem;
      }

      .activity-item p {
        margin: 0;
        font-size: 0.82rem;
        color: var(--muted);
      }

      .amount {
        font-weight: 700;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th, td {
        text-align: left;
        padding: 12px 10px;
        border-bottom: 1px solid var(--line);
      }

      th {
        color: var(--muted);
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
      }

      td {
        font-size: 0.96rem;
      }

      .status {
        display: inline-flex;
        padding: 7px 10px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
      }

      .status.success {
        background: rgba(19,194,165,0.12);
        color: #0f8b75;
      }

      .status.pending {
        background: rgba(255,182,72,0.14);
        color: #c98009;
      }

      .status.alert {
        background: rgba(255,107,107,0.12);
        color: #d75757;
      }

      .task-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .task-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 10px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--panel-soft);
      }

      .check {
        width: 22px;
        height: 22px;
        border-radius: 7px;
        background: rgba(91,108,255,0.14);
        color: var(--primary-strong);
        display: grid;
        place-items: center;
        font-size: 0.88rem;
        font-weight: 800;
      }

      .task-item h4 {
        margin: 0;
        font-size: 0.96rem;
      }

      .task-item p {
        margin: 3px 0 0;
        font-size: 0.8rem;
        color: var(--muted);
      }

      @media (max-width: 1080px) {
        .app-shell {
          grid-template-columns: 1fr;
        }

        .sidebar {
          padding-bottom: 10px;
        }

        .main-grid, .bottom-grid, .stats-grid {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media (max-width: 720px) {
        body { padding: 16px; }
        .content { padding: 18px; }
        .topbar, .hero, .panel-header {
          flex-direction: column;
          align-items: flex-start;
        }
        .main-grid, .bottom-grid, .stats-grid {
          grid-template-columns: 1fr;
        }
        .search {
          width: 100%;
        }
        .top-actions {
          width: 100%;
          flex-wrap: wrap;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <div class="brand">
          <div class="logo">C</div>
          <span>Cliente Pro</span>
        </div>

        <nav class="nav" aria-label="Navegação principal">
          <a href="#" class="nav-item active"><span class="nav-icon">⌂</span> Visão geral</a>
          <a href="#" class="nav-item"><span class="nav-icon">◫</span> Faturas</a>
          <a href="#" class="nav-item"><span class="nav-icon">▣</span> Relatórios</a>
          <a href="#" class="nav-item"><span class="nav-icon">◎</span> Clientes</a>
          <a href="#" class="nav-item"><span class="nav-icon">◔</span> Mensagens</a>
          <a href="#" class="nav-item"><span class="nav-icon">⚙</span> Configurações</a>
        </nav>

        <div class="sidebar-footer">
          <div class="label">Resumo</div>
          <div class="mini-card">
            <span>Saldo disponível</span>
            <strong>R$ 24.890</strong>
            <div class="chip success">+12.4% este mês</div>
          </div>
        </div>
      </aside>

      <main class="content">
        <header class="topbar">
          <div class="title-group">
            <h1>Painel do cliente</h1>
            <p>Bem-vindo de volta, Lucas</p>
          </div>

          <div class="top-actions">
            <label class="search" aria-label="Buscar">
              <span>⌕</span>
              <input type="text" value="Buscar" aria-label="Buscar no painel" />
            </label>
            <button class="btn primary">+ Novo relatório</button>
          </div>
        </header>

        <section class="hero">
          <div class="hero-copy">
            <div class="avatar">L</div>
            <div>
              <h2>Plano empresarial</h2>
              <p>Seu desempenho está acima da média mensal.</p>
            </div>
          </div>

          <div class="hero-badges">
            <span class="chip">Upgrade em 7 dias</span>
            <span class="chip success">82% de eficiência</span>
          </div>
        </section>

        <section class="stats-grid" aria-label="Estatísticas principais">
          <article class="stat-card">
            <div class="meta">
              <span>Receita total</span>
              <span class="stat-icon">↗</span>
            </div>
            <strong>R$ 84.2K</strong>
            <span class="trend up">▲ 18.2%</span>
          </article>

          <article class="stat-card">
            <div class="meta">
              <span>Pagamentos</span>
              <span class="stat-icon">✓</span>
            </div>
            <strong>1.284</strong>
            <span class="trend up">▲ 9.1%</span>
          </article>

          <article class="stat-card">
            <div class="meta">
              <span>Faturamento</span>
              <span class="stat-icon">◌</span>
            </div>
            <strong>R$ 12.6K</strong>
            <span class="trend up">▲ 4.8%</span>
          </article>

          <article class="stat-card">
            <div class="meta">
              <span>Ativos pendentes</span>
              <span class="stat-icon">!</span>
            </div>
            <strong>146</strong>
            <span class="trend down">▼ 3.4%</span>
          </article>
        </section>

        <section class="main-grid">
          <div class="panel">
            <div class="panel-header">
              <h3>Desempenho</h3>
              <span class="link">Últimos 6 meses</span>
            </div>

            <div class="chart-wrap">
              <svg class="chart" viewBox="0 0 760 245" preserveAspectRatio="none" aria-label="Gráfico de receita">
                <defs>
                  <linearGradient id="areaFill" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="#5b6cff" stop-opacity="0.32"/>
                    <stop offset="100%" stop-color="#5b6cff" stop-opacity="0.02"/>
                  </linearGradient>
                </defs>

                <g stroke="#e8edf7" stroke-width="1">
                  <line x1="0" y1="30" x2="760" y2="30"/>
                  <line x1="0" y1="90" x2="760" y2="90"/>
                  <line x1="0" y1="150" x2="760" y2="150"/>
                  <line x1="0" y1="210" x2="760" y2="210"/>
                </g>

                <path d="M 0 180 C 70 150, 90 70, 120 110 S 180 40, 220 70 S 300 170, 340 150 S 420 90, 460 120 S 540 40, 580 80 S 650 150, 760 90 L 760 245 L 0 245 Z" fill="url(#areaFill)"/>
                <path d="M 0 180 C 70 150, 90 70, 120 110 S 180 40, 220 70 S 300 170, 340 150 S 420 90, 460 120 S 540 40, 580 80 S 650 150, 760 90" fill="none" stroke="#5b6cff" stroke-width="4" stroke-linecap="round"/>

                <g fill="#5b6cff" opacity="0.9">
                  <circle cx="120" cy="110" r="5"/>
                  <circle cx="220" cy="70" r="5"/>
                  <circle cx="340" cy="150" r="5"/>
                  <circle cx="460" cy="120" r="5"/>
                  <circle cx="580" cy="80" r="5"/>
                  <circle cx="760" cy="90" r="5"/>
                </g>
              </svg>

              <div class="legend">
                <span class="legend-item"><span class="dot" style="background:#5b6cff"></span>Receita</span>
                <span>Jan</span>
                <span>Fev</span>
                <span>Mar</span>
                <span>Abr</span>
                <span>Mai</span>
                <span>Jun</span>
              </div>
            </div>
          </div>

          <div class="panel">
            <div class="panel-header">
              <h3>Atividade recente</h3>
              <span class="link">Ver tudo</span>
            </div>

            <div class="activity-list">
              <div class="activity-item">
                <div class="activity-icon" style="background:rgba(91,108,255,0.12); color:#4d5aea;">↗</div>
                <div class="meta">
                  <h4>Pagamento recebido</h4>
                  <p>Hoje, às 09:18</p>
                </div>
                <div class="amount">R$ 8.400</div>
              </div>

              <div class="activity-item">
                <div class="activity-icon" style="background:rgba(19,194,165,0.12); color:#118a78;">✓</div>
                <div class="meta">
                  <h4>Projeto concluído</h4>
                  <p>Ontem, às 17:42</p>
                </div>
                <div class="amount">4/4</div>
              </div>

              <div class="activity-item">
                <div class="activity-icon" style="background:rgba(255,182,72,0.12); color:#cf8500;">!</div>
                <div class="meta">
                  <h4>Revisão pendente</h4>
                  <p>Há 2 dias</p>
                </div>
                <div class="amount">3 itens</div>
              </div>
            </div>
          </div>
        </section>

        <section class="bottom-grid">
          <div class="panel">
            <div class="panel-header">
              <h3>Transações recentes</h3>
              <span class="link">Exportar</span>
            </div>

            <table>
              <thead>
                <tr>
                  <th>Cliente</th>
                  <th>Descrição</th>
                  <th>Valor</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Maria Silva</td>
                  <td>Plano anual</td>
                  <td>R$ 1.980</td>
                  <td><span class="status success">Pago</span></td>
                </tr>
                <tr>
                  <td>Vitor Gomes</td>
                  <td>Consultoria</td>
                  <td>R$ 840</td>
                  <td><span class="status pending">Pendente</span></td>
                </tr>
                <tr>
                  <td>Ateliê Nox</td>
                  <td>Suporte premium</td>
                  <td>R$ 1.240</td>
                  <td><span class="status success">Pago</span></td>
                </tr>
                <tr>
                  <td>Júlia Costa</td>
                  <td>Reembolso</td>
                  <td>R$ 420</td>
                  <td><span class="status alert">Atenção</span></td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="panel">
            <div class="panel-header">
              <h3>Checklist do mês</h3>
              <span class="link">Atualizar</span>
            </div>

            <div class="task-list">
              <div class="task-item">
                <div class="check">✓</div>
                <div>
                  <h4>Reunião de progresso</h4>
                  <p>Hoje · 14:30</p>
                </div>
              </div>

              <div class="task-item">
                <div class="check">✓</div>
                <div>
                  <h4>Relatório financeiro</h4>
                  <p>Hoje · 18:00</p>
                </div>
              </div>

              <div class="task-item">
                <div class="check">✓</div>
                <div>
                  <h4>Feedback do cliente</h4>
                  <p>amanhã · 10:00</p>
                </div>
              </div>

              <div class="task-item">
                <div class="check">✓</div>
                <div>
                  <h4>Plano de expansão</h4>
                  <p>próxima semana</p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

