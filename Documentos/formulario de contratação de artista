<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Contratar artista | ArtConnect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
/* ArtConnect — estilos compartilhados
   Estética: creme + preto + vermelho-alaranjado, títulos condensados em caixa alta,
   rótulos em fonte mono. Ajuste as cores e fontes nas variáveis abaixo. */
:root {
  --creme: #f0e6d6;
  --creme-card: #f6f0e4;
  --tinta: #1a1311;
  --vermelho: #e0391a;
  --vermelho-escuro: #c22e12;
  --suave: #5c524a;
  --borda: #cfc4b3;
  --erro: #ff6b4a;
  --sucesso: #2f7d3b;
  --fonte-titulo: "Anton", "Bebas Neue", Impact, sans-serif;
  --fonte-texto: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  --fonte-mono: "Space Mono", ui-monospace, "Courier New", monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: var(--fonte-texto);
  color: var(--tinta);
  background: var(--creme);
  line-height: 1.55;
}
a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }

.container { width: min(1088px, 100% - 48px); margin-inline: auto; }

/* ---------- Títulos e rótulos ---------- */
h1, h2, h3 {
  font-family: var(--fonte-titulo);
  font-weight: 400;
  text-transform: uppercase;
  line-height: .93;
  letter-spacing: -.005em;
}
h1 { font-size: clamp(2.8rem, 7.5vw, 5.4rem); }
h2 { font-size: clamp(2rem, 4.5vw, 3rem); }
h3 { font-size: 1.5rem; }

.eyebrow {
  font-family: var(--fonte-mono);
  font-size: .72rem;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--suave);
  margin-bottom: 12px;
}
.eyebrow.vermelho { color: var(--vermelho); }

.sub { color: var(--suave); font-size: 1.1rem; max-width: 560px; margin-top: 20px; }

/* ---------- Cabeçalho ---------- */
.topo {
  position: sticky; top: 0; z-index: 10;
  background: var(--creme);
  border-bottom: 1px solid var(--borda);
}
.topo .container {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 64px; gap: 16px; flex-wrap: wrap;
}
.logo {
  display: flex; align-items: center; gap: 10px;
  font-family: var(--fonte-titulo); font-size: 1.7rem; letter-spacing: .01em;
}
.logo::before {
  content: ""; width: 12px; height: 12px; border-radius: 50%; background: var(--vermelho);
}
.menu { display: flex; gap: 28px; font-size: .92rem; color: var(--suave); }
.menu a { transition: color .2s; }
.menu a:hover, .menu a.ativo { color: var(--tinta); font-weight: 600; }

/* ---------- Botões ---------- */
.btn {
  display: inline-block; border: 0; cursor: pointer;
  padding: 14px 30px; border-radius: 999px;
  font-family: var(--fonte-texto); font-size: .98rem; font-weight: 600;
  background: var(--vermelho); color: #fff;
  transition: background .2s, transform .15s;
}
.btn:hover { background: var(--vermelho-escuro); transform: translateY(-1px); }
.btn-escuro { background: var(--tinta); padding: 11px 22px; font-size: .9rem; }
.btn-escuro:hover { background: #000; }
.btn-contorno { background: transparent; color: var(--tinta); border: 1.5px solid var(--tinta); padding: 11px 22px; font-size: .9rem; }
.btn-contorno:hover { background: var(--tinta); color: var(--creme); }

/* ---------- Abertura das páginas ---------- */
.abertura { padding: 72px 0 56px; border-bottom: 1px solid var(--borda); }
.abertura h1 { max-width: 820px; }

main { padding: 56px 0 80px; }
section + section { margin-top: 72px; }
.cabeca-secao { margin-bottom: 28px; }

/* ---------- Cartões e etiquetas ---------- */
.card {
  background: var(--creme-card);
  border: 1px solid var(--borda);
  border-radius: 24px;
  padding: 26px;
}
.tag {
  display: inline-block;
  font-family: var(--fonte-mono); font-size: .7rem;
  letter-spacing: .16em; text-transform: uppercase;
  color: var(--vermelho);
}

/* ---------- Campos ---------- */
label {
  display: block; margin-bottom: 8px;
  font-family: var(--fonte-mono); font-size: .7rem;
  letter-spacing: .2em; text-transform: uppercase; color: var(--suave);
}
input, select, textarea {
  width: 100%; padding: 14px 16px;
  font-family: var(--fonte-texto); font-size: .95rem;
  color: var(--tinta); background: var(--creme-card);
  border: 1px solid var(--borda); border-radius: 14px;
  transition: border-color .2s, box-shadow .2s;
}
input:focus, select:focus, textarea:focus {
  outline: none; border-color: var(--vermelho);
  box-shadow: 0 0 0 3px rgba(224, 57, 26, .18);
}
textarea { min-height: 130px; resize: vertical; }

/* ---------- Agenda ---------- */
.filtros {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px; align-items: end; margin-bottom: 32px;
}
.lista-shows { display: grid; gap: 16px; }
.show {
  display: grid; grid-template-columns: 96px 1fr auto;
  gap: 24px; align-items: center; padding: 20px 26px;
}
.show-data {
  text-align: center; padding-right: 24px; border-right: 1px solid var(--borda);
}
.show-data strong { display: block; font-family: var(--fonte-titulo); font-weight: 400; font-size: 3rem; line-height: 1; color: var(--vermelho); }
.show-data span { font-family: var(--fonte-mono); font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--suave); }
.show h3 { margin: 6px 0 4px; }
.show-info { color: var(--suave); font-size: .92rem; }
.sem-resultado { display: none; text-align: center; color: var(--suave); padding: 48px 0; }

/* ---------- Seção escura (formulário) ---------- */
.secao-escura { background: var(--tinta); color: var(--creme); padding: 72px 0 80px; }
.secao-escura h1, .secao-escura h2 { color: var(--creme); }
.secao-escura .eyebrow { color: #a89a8a; }
.secao-escura .eyebrow.vermelho { color: var(--vermelho); }
.secao-escura label { color: #a89a8a; }
.secao-escura input, .secao-escura select, .secao-escura textarea {
  background: transparent; color: var(--creme);
  border-color: rgba(240, 230, 214, .28); color-scheme: dark;
}
.secao-escura input::placeholder, .secao-escura textarea::placeholder { color: #8a7d70; }
.secao-escura select option { background: var(--tinta); color: var(--creme); }

.layout-form { display: grid; grid-template-columns: 1fr 400px; gap: 40px; align-items: start; margin-top: 32px; }
.grade-campos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.campo-total { grid-column: 1 / -1; }
.erro-msg { display: none; color: var(--erro); font-size: .8rem; margin-top: 6px; }
.campo.invalido input, .campo.invalido select, .campo.invalido textarea { border-color: var(--erro); }
.campo.invalido .erro-msg { display: block; }
.aviso-ok {
  display: none; margin-top: 20px; padding: 16px 20px; border-radius: 14px;
  background: rgba(47, 125, 59, .18); color: #9be3a6; font-weight: 600;
}

.resumo { color: var(--tinta); }
.resumo .eyebrow { margin-bottom: 18px; }
.resumo-linha {
  display: flex; justify-content: space-between; gap: 16px;
  padding: 14px 0; border-bottom: 1px solid var(--borda); font-size: .95rem;
}
.resumo-linha span:first-child { color: var(--suave); }
.resumo-linha span:last-child { font-weight: 500; text-align: right; }
.resumo-nota { margin-top: 16px; font-size: .8rem; color: var(--suave); }

/* ---------- Sobre ---------- */
.texto-longo { max-width: 720px; }
.texto-longo p { margin-top: 16px; color: var(--suave); font-size: 1.05rem; }
.grade-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }
.card h3 { margin-bottom: 10px; }
.card p { color: var(--suave); font-size: .95rem; }
.passo-num { font-family: var(--fonte-titulo); font-size: 3rem; line-height: 1; color: var(--vermelho); margin-bottom: 10px; }
.categorias { display: flex; flex-wrap: wrap; gap: 12px; }
.pilula {
  padding: 10px 20px; border-radius: 999px; border: 1px solid var(--tinta);
  font-family: var(--fonte-mono); font-size: .74rem; letter-spacing: .14em; text-transform: uppercase;
}
.chamada { background: var(--tinta); color: var(--creme); border-radius: 28px; padding: 64px 32px; text-align: center; }
.chamada h2 { color: var(--creme); }
.chamada p { margin: 16px auto 28px; max-width: 480px; color: #c9bba9; }

/* ---------- Rodapé ---------- */
.rodape { border-top: 1px solid var(--borda); padding: 36px 0; background: var(--creme); }
.rodape .container { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
.rodape .logo { font-size: 1.4rem; }
.rodape-texto { font-family: var(--fonte-mono); font-size: .75rem; letter-spacing: .06em; color: var(--suave); }
.rodape-texto a:hover { color: var(--vermelho); }

/* ---------- Responsivo ---------- */
@media (max-width: 900px) {
  .layout-form { grid-template-columns: 1fr; }
}
@media (max-width: 680px) {
  .grade-campos { grid-template-columns: 1fr; }
  .show { grid-template-columns: 76px 1fr; gap: 16px; }
  .show .btn { grid-column: 1 / -1; text-align: center; }
  .show-data { padding-right: 14px; }
  .show-data strong { font-size: 2.4rem; }
  .menu { display: none; }
  .abertura { padding: 48px 0 40px; }
}

</style>
</head>
<body>

<header class="topo">
  <div class="container">
    <a href="#" class="logo">ArtConnect</a>
    <nav class="menu">
      <a href="agenda.html">Eventos</a>
      <a href="#">Artistas</a>
      <a href="sobre.html">Sobre</a>
    </nav>
    <a href="contratacao.html" class="btn btn-escuro">Encontrar Artistas</a>
  </div>
</header>

<section class="secao-escura">
  <div class="container">
    <p class="eyebrow vermelho">(A) Brief do evento</p>
    <h1>Conte sobre o seu evento</h1>

    <div class="layout-form">

      <form id="form-contratacao" novalidate>
        <div class="grade-campos">

          <div class="campo">
            <label for="tipo">Tipo de evento</label>
            <select id="tipo" name="tipo" required>
              <option value="">Selecione</option>
              <option>Casamento</option>
              <option>Aniversário</option>
              <option>Corporativo</option>
              <option>Formatura</option>
              <option>Show / Festival</option>
            </select>
            <p class="erro-msg">Escolha o tipo de evento.</p>
          </div>

          <div class="campo">
            <label for="categoria">Categoria artística</label>
            <select id="categoria" name="categoria" required>
              <option value="">Selecione</option>
              <option>DJ Set</option>
              <option>Jazz &amp; MPB</option>
              <option>Folk Acústico</option>
              <option>Mágicos</option>
              <option>Chefs &amp; Buffet</option>
              <option>Foto &amp; Vídeo</option>
            </select>
            <p class="erro-msg">Escolha uma categoria.</p>
          </div>

          <div class="campo">
            <label for="data">Data</label>
            <input type="date" id="data" name="data" required>
            <p class="erro-msg">Escolha uma data a partir de amanhã.</p>
          </div>

          <div class="campo">
            <label for="orcamento">Orçamento (R$)</label>
            <input type="number" id="orcamento" name="orcamento" min="1" step="50" placeholder="2500" required>
            <p class="erro-msg">Informe um valor maior que zero.</p>
          </div>

          <div class="campo campo-total">
            <label for="local">Localização</label>
            <input type="text" id="local" name="local" placeholder="Cidade ou região" required>
            <p class="erro-msg">Informe onde será o evento.</p>
          </div>

          <div class="campo">
            <label for="nome">Seu nome</label>
            <input type="text" id="nome" name="nome" placeholder="Nome completo" required>
            <p class="erro-msg">Informe seu nome completo.</p>
          </div>

          <div class="campo">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" placeholder="voce@email.com" required>
            <p class="erro-msg">Informe um e-mail válido.</p>
          </div>

          <div class="campo">
            <label for="telefone">Telefone / WhatsApp</label>
            <input type="tel" id="telefone" name="telefone" placeholder="(31) 99999-9999" required>
            <p class="erro-msg">Informe um telefone com DDD.</p>
          </div>

          <div class="campo">
            <label for="convidados">Nº de convidados (opcional)</label>
            <input type="number" id="convidados" name="convidados" min="1" placeholder="80">
            <p class="erro-msg">Use um número maior que zero.</p>
          </div>

          <div class="campo campo-total">
            <label for="mensagem">Detalhes do evento</label>
            <textarea id="mensagem" name="mensagem" required
              placeholder="Horário, estilo desejado, duração, referências..."></textarea>
            <p class="erro-msg">Escreva pelo menos 15 caracteres.</p>
          </div>

          <div class="campo campo-total">
            <button type="submit" class="btn">Encontrar Artistas</button>
          </div>
        </div>

        <p class="aviso-ok" id="aviso-ok" role="status">
          Pedido enviado! Vamos listar os artistas mais compatíveis e eles entrarão em contato.
        </p>
      </form>

      <aside class="card resumo">
        <p class="eyebrow">Resumo</p>
        <div class="resumo-linha"><span>Tipo</span><span id="r-tipo">A definir</span></div>
        <div class="resumo-linha"><span>Categoria</span><span id="r-categoria">A definir</span></div>
        <div class="resumo-linha"><span>Data</span><span id="r-data">A definir</span></div>
        <div class="resumo-linha"><span>Localização</span><span id="r-local">A definir</span></div>
        <div class="resumo-linha"><span>Orçamento</span><span id="r-orcamento">A definir</span></div>
        <p class="resumo-nota">Ordenamos por compatibilidade: categoria, orçamento, região e disponibilidade. O pagamento fica retido até o dia do evento.</p>
      </aside>

    </div>
  </div>
</section>

<footer class="rodape">
  <div class="container">
    <a href="#" class="logo">ArtConnect</a>
    <span class="rodape-texto">© 2026 ArtConnect · Feito para artistas locais no Brasil</span>
  </div>
</footer>

<script>
  const form = document.getElementById('form-contratacao');
  const aviso = document.getElementById('aviso-ok');
  const campos = [...form.querySelectorAll('input, select, textarea')];

  // Data mínima: amanhã
  const amanha = new Date();
  amanha.setDate(amanha.getDate() + 1);
  document.getElementById('data').min = amanha.toISOString().split('T')[0];

  // Resumo ao vivo
  const resumo = {
    tipo: document.getElementById('r-tipo'),
    categoria: document.getElementById('r-categoria'),
    data: document.getElementById('r-data'),
    local: document.getElementById('r-local'),
    orcamento: document.getElementById('r-orcamento')
  };
  function atualizarResumo() {
    const v = id => document.getElementById(id).value.trim();
    resumo.tipo.textContent = v('tipo') || 'A definir';
    resumo.categoria.textContent = v('categoria') || 'A definir';
    resumo.local.textContent = v('local') || 'A definir';
    resumo.data.textContent = v('data') ? v('data').split('-').reverse().join('/') : 'A definir';
    resumo.orcamento.textContent = Number(v('orcamento')) > 0
      ? 'R$ ' + Number(v('orcamento')).toLocaleString('pt-BR') : 'A definir';
  }
  campos.forEach(el => el.addEventListener('input', atualizarResumo));
  campos.forEach(el => el.addEventListener('change', atualizarResumo));

  // Validação
  function campoValido(el) {
    const v = el.value.trim();
    if (el.required && !v) return false;
    if (el.id === 'nome' && v.length < 3) return false;
    if (el.id === 'mensagem' && v.length < 15) return false;
    if (el.id === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return false;
    if (el.id === 'telefone' && v.replace(/\D/g, '').length < 10) return false;
    if (el.id === 'data' && (!v || v < el.min)) return false;
    if (el.id === 'orcamento' && !(Number(v) > 0)) return false;
    if (el.id === 'convidados' && v && !(Number(v) > 0)) return false;
    return true;
  }
  function validar(el) {
    el.closest('.campo').classList.toggle('invalido', !campoValido(el));
  }
  campos.forEach(el => el.addEventListener('blur', () => validar(el)));

  form.addEventListener('submit', e => {
    e.preventDefault();
    aviso.style.display = 'none';
    campos.forEach(validar);
    const erro = form.querySelector('.invalido input, .invalido select, .invalido textarea');
    if (erro) { erro.focus(); return; }

    // Aqui entra o envio real (API, Zoho Creator, e-mail...).
    aviso.style.display = 'block';
    form.reset();
    atualizarResumo();
  });
</script>
</body>
</html>
