# Copie este arquivo para ".env" e preencha com os dados do seu banco.
# Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/artconnect
SECRET_KEY=troque-por-uma-frase-secreta

# Opcional: envio real do e-mail de recuperação de senha
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=587
# SMTP_USUARIO=seu-email@gmail.com
# SMTP_SENHA=senha-de-app
# SMTP_REMETENTE=seu-email@gmail.com
