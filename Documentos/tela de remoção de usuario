<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Excluir conta · ArtConnect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #ede5d4;
      --ink: #140f0d;
      --ink-card: #1e1714;
      --line: rgba(20, 15, 13, 0.14);
      --line-dark: rgba(245, 240, 232, 0.16);
      --muted: #6b6159;
      --muted-light: #b9ada0;
      --cream: #f5f0e8;
      --accent: #d04727;
      --danger: #e5484d;
      --danger-hover: #cf383d;
      --radius-lg: 28px;
      --radius-md: 20px;
      --radius-pill: 999px;
      --font-display: "Anton", "Arial Narrow", Impact, sans-serif;
      --font-body: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
      --font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-body);
      line-height: 1.5;
    }

    /* ---------- Cabeçalho ---------- */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 20px 24px;
      border-bottom: 1px solid var(--line);
    }
    .logo {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--ink);
      text-decoration: none;
      font-family: var(--font-display);
      font-size: 34px;
      line-height: 1;
      letter-spacing: -0.02em;
    }
    .logo::before {
      content: "";
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--accent);
    }

    /* ---------- Botões ---------- */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: 0;
      border-radius: var(--radius-pill);
      padding: 14px 24px;
      font: 600 17px/1 var(--font-body);
      text-decoration: none;
      cursor: pointer;
      transition: background-color .15s ease, opacity .15s ease, transform .1s ease;
    }
    .btn:active { transform: scale(0.98); }
    .btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

    .btn--dark { background: var(--ink); color: var(--cream); }
    .btn--dark:hover { background: #2a201c; }

    .btn--block { width: 100%; padding: 20px 24px; font-size: 18px; }

    .btn--danger { background: var(--danger); color: #fff; }
    .btn--danger:hover:not(:disabled) { background: var(--danger-hover); }
    .btn--danger:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .btn--ghost {
      background: transparent;
      color: var(--cream);
      border: 1px solid var(--line-dark);
      margin-top: 12px;
    }
    .btn--ghost:hover { border-color: rgba(245, 240, 232, 0.4); }

    /* ---------- Conteúdo ---------- */
    .main {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 40px 24px 56px;
    }
    .panel { width: 100%; max-width: 520px; }

    .eyebrow {
      margin: 0 0 14px;
      font: 500 14px/1.4 var(--font-mono);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--danger);
    }
    .title {
      margin: 0 0 16px;
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(48px, 14vw, 72px);
      line-height: 0.95;
      letter-spacing: -0.02em;
      text-transform: uppercase;
    }
    .lead {
      margin: 0 0 32px;
      font-size: 18px;
      color: var(--muted);
    }

    /* ---------- Card ---------- */
    .card {
      background: var(--ink-card);
      color: var(--cream);
      border: 1px solid var(--line-dark);
      border-radius: var(--radius-lg);
      padding: 32px 24px 28px;
    }

    .warning {
      margin: 0 0 28px;
      padding: 20px;
      border: 1px solid rgba(229, 72, 77, 0.45);
      background: rgba(229, 72, 77, 0.08);
      border-radius: var(--radius-md);
    }
    .warning h2 {
      margin: 0 0 12px;
      font: 500 14px/1.2 var(--font-mono);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--danger);
    }
    .warning ul {
      margin: 0;
      padding-left: 20px;
      font-size: 15px;
      color: var(--cream);
    }
    .warning li + li { margin-top: 8px; }
    .warning li::marker { color: var(--danger); }

    .field { margin-bottom: 24px; }
    .field label {
      display: block;
      margin-bottom: 12px;
      font: 500 14px/1.2 var(--font-mono);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--muted-light);
    }
    .hint {
      margin: 10px 4px 0;
      font-size: 13px;
      color: var(--muted-light);
    }
    .hint strong {
      font-family: var(--font-mono);
      font-weight: 500;
      color: var(--cream);
      letter-spacing: 0.08em;
    }

    .input {
      width: 100%;
      height: 60px;
      padding: 0 22px;
      background: transparent;
      color: var(--cream);
      border: 1px solid var(--line-dark);
      border-radius: var(--radius-pill);
      font: 400 18px/1 var(--font-body);
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .input::placeholder { color: rgba(185, 173, 160, 0.55); }
    .input:hover { border-color: rgba(245, 240, 232, 0.32); }
    .input:focus {
      outline: none;
      border-color: var(--danger);
      box-shadow: 0 0 0 3px rgba(229, 72, 77, 0.28);
    }
    .input:-webkit-autofill,
    .input:-webkit-autofill:focus {
      -webkit-text-fill-color: var(--cream);
      caret-color: var(--cream);
      -webkit-box-shadow: 0 0 0 1000px var(--ink-card) inset;
      transition: background-color 9999s ease-in-out 0s;
    }

    .confirm {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin: 0 0 28px;
      font-size: 15px;
      color: var(--muted-light);
      cursor: pointer;
    }
    .confirm input {
      flex: none;
      width: 20px;
      height: 20px;
      margin: 2px 0 0;
      accent-color: var(--danger);
    }

    .note {
      margin: 24px 0 0;
      font: 400 13px/1.5 var(--font-mono);
      letter-spacing: 0.04em;
      color: var(--muted);
    }
    .note strong { color: var(--ink); font-weight: 500; }

    /* ---------- Rodapé ---------- */
    .footer {
      padding: 24px;
      border-top: 1px solid var(--line);
      font: 400 13px/1.5 var(--font-mono);
      letter-spacing: 0.04em;
      color: var(--muted);
    }

    @media (min-width: 768px) {
      .header { padding: 24px 48px; }
      .main { padding: 72px 48px 96px; }
      .card { padding: 40px 36px 32px; }
      .footer { padding: 28px 48px; }
    }
    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }
  </style>
</head>
<body>

  <header class="header">
    <a class="logo" href="/">ArtConnect</a>
    <a class="btn btn--dark" href="/painel">Meu painel</a>
  </header>

  <main class="main">
    <section class="panel" aria-labelledby="delete-title">
      <p class="eyebrow">Zona de perigo</p>
      <h1 class="title" id="delete-title">Excluir<br>minha conta</h1>
      <p class="lead">Essa ação é permanente. Leia com atenção antes de continuar.</p>

      <form class="card" id="delete-form" action="/conta/excluir" method="post">

        <div class="warning" role="alert">
          <h2>O que acontece</h2>
          <ul>
            <li>Seu perfil, orçamentos e propostas serão apagados.</li>
            <li>Você perde o acesso ao painel e ao histórico de contratações.</li>
            <li>Não é possível desfazer. Para voltar, será preciso criar uma nova conta.</li>
            <li>Contratações com pagamento retido precisam ser concluídas antes da exclusão.</li>
          </ul>
        </div>

        <div class="field">
          <label for="password">Sua senha</label>
          <input
            class="input"
            id="password"
            name="password"
            type="password"
            placeholder="••••••••"
            autocomplete="current-password"
            required>
        </div>

        <div class="field">
          <label for="confirm-text">Confirmação</label>
          <input
            class="input"
            id="confirm-text"
            name="confirm_text"
            type="text"
            placeholder="EXCLUIR"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            required>
          <p class="hint">Digite <strong>EXCLUIR</strong> para confirmar.</p>
        </div>

        <label class="confirm">
          <input type="checkbox" id="confirm-check" name="confirm_check" required>
          Entendo que a exclusão é definitiva e não pode ser desfeita.
        </label>

        <button class="btn btn--danger btn--block" id="delete-btn" type="submit" disabled>
          Excluir minha conta
        </button>
        <a class="btn btn--ghost btn--block" href="/painel">Cancelar e voltar</a>
      </form>

      <p class="note"><strong>Pagamento retido</strong> até o dia do evento. Finalize suas contratações antes de excluir.</p>
    </section>
  </main>

  <footer class="footer">
    © 2026 ArtConnect · Feito para artistas locais no Brasil
  </footer>

  <script>
    // Habilita o botão só quando tudo estiver preenchido corretamente.
    (function () {
      var pass = document.getElementById('password');
      var text = document.getElementById('confirm-text');
      var check = document.getElementById('confirm-check');
      var btn = document.getElementById('delete-btn');

      function update() {
        btn.disabled = !(
          pass.value.length > 0 &&
          text.value.trim().toUpperCase() === 'EXCLUIR' &&
          check.checked
        );
      }

      [pass, text, check].forEach(function (el) {
        el.addEventListener('input', update);
        el.addEventListener('change', update);
      });
      update();
    })();
  </script>

</body>
</html>
