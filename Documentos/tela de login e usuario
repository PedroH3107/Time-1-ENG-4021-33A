<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Entrar · ArtConnect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #ede5d4;
      --bg-soft: #f5f0e8;
      --ink: #140f0d;
      --ink-card: #1e1714;
      --line: rgba(20, 15, 13, 0.14);
      --line-dark: rgba(245, 240, 232, 0.16);
      --muted: #6b6159;
      --muted-light: #b9ada0;
      --cream: #f5f0e8;
      --accent: #d04727;
      --accent-hover: #b93b1e;
      --radius-lg: 28px;
      --radius-pill: 999px;
      --font-display: "Anton", "Arial Narrow", Impact, sans-serif;
      --font-body: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
      --font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html { -webkit-text-size-adjust: 100%; }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-body);
      line-height: 1.5;
    }

    /* ---------- Cabeçalho ---------- */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 20px 24px;
      border-bottom: 1px solid var(--line);
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--ink);
      text-decoration: none;
      font-family: var(--font-display);
      font-size: 34px;
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .logo::before {
      content: "";
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--accent);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: 0;
      border-radius: var(--radius-pill);
      padding: 14px 24px;
      font: 600 17px/1 var(--font-body);
      text-decoration: none;
      cursor: pointer;
      transition: background-color .15s ease, transform .1s ease;
    }
    .btn:active { transform: scale(0.98); }
    .btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

    .btn--dark { background: var(--ink); color: var(--cream); }
    .btn--dark:hover { background: #2a201c; }

    .btn--accent {
      width: 100%;
      padding: 20px 24px;
      background: var(--accent);
      color: #fff;
      font-size: 18px;
    }
    .btn--accent:hover { background: var(--accent-hover); }

    /* ---------- Conteúdo ---------- */
    .main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 24px 56px;
    }

    .login {
      width: 100%;
      max-width: 460px;
    }

    .eyebrow {
      margin: 0 0 14px;
      font: 500 14px/1.4 var(--font-mono);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .title {
      margin: 0 0 16px;
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(48px, 14vw, 72px);
      line-height: 0.95;
      letter-spacing: -0.02em;
      text-transform: uppercase;
    }

    .lead {
      margin: 0 0 32px;
      font-size: 18px;
      color: var(--muted);
    }

    /* ---------- Card do formulário ---------- */
    .card {
      background: var(--ink-card);
      color: var(--cream);
      border: 1px solid var(--line-dark);
      border-radius: var(--radius-lg);
      padding: 32px 24px 28px;
    }

    .field { margin-bottom: 24px; }

    .field label,
    .field .label-row span {
      display: block;
      margin-bottom: 12px;
      font: 500 14px/1.2 var(--font-mono);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--muted-light);
    }

    .label-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
    }
    .label-row label { margin-bottom: 12px; }

    .link-small {
      font: 500 12px/1.2 var(--font-mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      text-decoration: none;
    }
    .link-small:hover { text-decoration: underline; }

    .input {
      width: 100%;
      height: 60px;
      padding: 0 22px;
      background: transparent;
      color: var(--cream);
      border: 1px solid var(--line-dark);
      border-radius: var(--radius-pill);
      font: 400 18px/1 var(--font-body);
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .input::placeholder { color: rgba(185, 173, 160, 0.55); }
    .input:hover { border-color: rgba(245, 240, 232, 0.32); }
    .input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(208, 71, 39, 0.28);
    }

    /* Evita o fundo azul/branco do autofill do navegador */
    .input:-webkit-autofill,
    .input:-webkit-autofill:focus {
      -webkit-text-fill-color: var(--cream);
      caret-color: var(--cream);
      -webkit-box-shadow: 0 0 0 1000px var(--ink-card) inset;
      transition: background-color 9999s ease-in-out 0s;
    }

    .remember {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: -4px 0 28px;
      font-size: 15px;
      color: var(--muted-light);
      cursor: pointer;
    }
    .remember input {
      width: 20px;
      height: 20px;
      margin: 0;
      accent-color: var(--accent);
    }

    .signup {
      margin: 24px 0 0;
      text-align: center;
      font-size: 15px;
      color: var(--muted-light);
    }
    .signup a {
      color: var(--cream);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .signup a:hover { color: var(--accent); }

    .secure {
      margin: 24px 0 0;
      font: 400 13px/1.5 var(--font-mono);
      letter-spacing: 0.04em;
      color: var(--muted);
    }
    .secure strong { color: var(--ink); font-weight: 500; }

    /* ---------- Rodapé ---------- */
    .footer {
      padding: 24px;
      border-top: 1px solid var(--line);
      font: 400 13px/1.5 var(--font-mono);
      letter-spacing: 0.04em;
      color: var(--muted);
    }

    /* ---------- Telas maiores ---------- */
    @media (min-width: 768px) {
      .header { padding: 24px 48px; }
      .main { padding: 72px 48px 96px; }
      .card { padding: 40px 36px 32px; }
      .footer { padding: 28px 48px; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }
  </style>
</head>
<body>

  <header class="header">
    <a class="logo" href="/">ArtConnect</a>
    <a class="btn btn--dark" href="/orcamento">Pedir orçamento</a>
  </header>

  <main class="main">
    <section class="login" aria-labelledby="login-title">
      <p class="eyebrow">Acesse sua conta</p>
      <h1 class="title" id="login-title">Entrar no<br>seu painel</h1>
      <p class="lead">Acompanhe orçamentos, propostas e pagamentos em um só lugar.</p>

      <form class="card" action="/login" method="post">
        <div class="field">
          <label for="username">Usuário</label>
          <input
            class="input"
            id="username"
            name="username"
            type="text"
            placeholder="Seu nome de usuário"
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            required>
        </div>

        <div class="field">
          <div class="label-row">
            <label for="password">Senha</label>
            <a class="link-small" href="/recuperar-senha">Esqueci a senha</a>
          </div>
          <input
            class="input"
            id="password"
            name="password"
            type="password"
            placeholder="••••••••"
            autocomplete="current-password"
            minlength="6"
            required>
        </div>

        <label class="remember">
          <input type="checkbox" name="remember">
          Manter conectado neste dispositivo
        </label>

        <button class="btn btn--accent" type="submit">Entrar</button>

        <p class="signup">Ainda não tem conta? <a href="/cadastro">Criar conta</a></p>
      </form>

      <p class="secure"><strong>Pagamento retido</strong> até o dia do evento.</p>
    </section>
  </main>

  <footer class="footer">
    © 2026 ArtConnect · Feito para artistas locais no Brasil
  </footer>

</body>
</html>
